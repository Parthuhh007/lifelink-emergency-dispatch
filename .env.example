# ==========================================

# LIFELINK — Environment Configuration

# ==========================================

# Application

NODE_ENV=development

# ==========================================

# Database

# ==========================================

MONGO_URI=mongodb://localhost:27017/lifelink

# ==========================================

# Authentication & Security

# ==========================================

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ==========================================

# Service Ports

# ==========================================

GATEWAY_PORT=8000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
EMERGENCY_SERVICE_PORT=3003
RESPONSE_SERVICE_PORT=3004
ADMIN_SERVICE_PORT=3005

# ==========================================

# Internal Service URLs

# ==========================================

AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
EMERGENCY_SERVICE_URL=http://emergency-service:3003
RESPONSE_SERVICE_URL=http://response-service:3004
ADMIN_SERVICE_URL=http://admin-service:3005

# ==========================================

# Frontend

# ==========================================

VITE_API_URL=http://localhost:8000

# ==========================================

# Maps

# ==========================================

MAP_PROVIDER=maptiler
MAP_API_KEY=

# Optional alternative map providers

MAPTILER_API_KEY=
MAPBOX_API_KEY=
GOOGLE_MAPS_API_KEY=

# ==========================================

# Geolocation / Routing

# ==========================================

GEOCODING_PROVIDER=
ROUTING_PROVIDER=

# ==========================================

# Realtime

# ==========================================

POLLING_INTERVAL_MS=3000

# ==========================================

# Emergency Configuration

# ==========================================

EMERGENCY_ALERT_SOUND_URL=https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3
